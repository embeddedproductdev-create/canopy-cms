{
  "name": "canopy-cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "build:cf": "cross-env PAYLOAD_USE_LOCAL_BINDINGS=true NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" opennextjs-cloudflare build",
    "deploy:database": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command \"PRAGMA optimize\" --remote",
    "apply:cleanup": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node scripts/apply-remote-cleanup.ts",
    "verify:remote": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node scripts/verify-remote-migrations.ts",
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" PAYLOAD_MIGRATING=true node scripts/prepare-dev-schema.ts && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "npm run generate:types:cloudflare && npm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "notify:test": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env scripts/notify-test.ts",
    "docs:content": "node --no-warnings --import=tsx/esm scripts/generate-content-map.ts",
    "docs:cms": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node scripts/generate-cms-guide.ts",
    "seed:rebuild": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node scripts/rebuild-seed.ts",
    "seed:local": "wrangler d1 execute D1 --local --file seed/db-dump.sql -y && node -e \"require('fs').cpSync('seed/media','media',{recursive:true})\"",
    "replace:db": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node scripts/replace-remote-db.ts",
    "sync:db": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node scripts/sync-remote-db.ts",
    "sync:media": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node scripts/sync-remote-media.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "@payloadcms/db-d1-sqlite": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-r2": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.6",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}
