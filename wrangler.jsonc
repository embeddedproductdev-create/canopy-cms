{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "canopy-cms",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "7867eb04-6cb3-4d64-83a8-a5f8c01eaf30",
      "database_name": "canopy-cms-db",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "canopy-cms-r2-bucket",
      "preview_bucket_name": "canopy-cms-r2-bucket"
    }
  ]
}